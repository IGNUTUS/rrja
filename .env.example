# Form submission endpoint (Formspree, Getform, Basin, or your own API) that accepts a JSON POST.
# Leave empty to keep the contact form in "not connected" mode. It will NOT claim a message was sent.
VITE_FORM_ENDPOINT=

# Production URL without a trailing slash. Used for canonical URLs and Open Graph. Leave empty until confirmed.
VITE_SITE_URL=

# Show the small "To confirm" markers next to unverified details (recommended for client review).
# Set to "false" once every detail has been confirmed by RRJA.
VITE_SHOW_PENDING_MARKERS=true
